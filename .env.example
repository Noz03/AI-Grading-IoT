ENVIRONMENT=development
UPLOAD_DIR=./uploads

POSTGRES_USER=ai_grading_user
POSTGRES_PASSWORD=replace_with_your_password
POSTGRES_DB=ai_grading_iot

DATABASE_URL=postgresql+psycopg://ai_grading_user:replace_with_your_password@127.0.0.1:5432/ai_grading_iot

# Set a random secret of at least 32 bytes before using login or protected routes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800

# Required only when explicitly running the admin seed command.
SEED_ADMIN_EMAIL=
SEED_ADMIN_FULL_NAME=
SEED_ADMIN_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GRADING_TIMEOUT_SECONDS=60
YOLO_MODEL_PATH=./models/yolo11_iot/best.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45
VISION_MAX_IMAGES=5
VISION_MAX_CONCURRENT_INFERENCES=1
VISION_GROQ_MODEL=
VISION_GROQ_TIMEOUT_SECONDS=60
